<div class="container-fluid mt-5 mb-3 item-index">
  <div class="row">

    <div class="col-md-3">
      <div class="mx-auto w-50 border border-dark border-2 pb-5">
        <h2 class="fs-6 fw-bold text-center py-1 border-bottom border-dark border-2">ジャンル検索</h2>
        <% @genres.each do |genre| %>
          <p class="ps-3"><%= genre.name%></p>
        <% end %>
      </div>
    </div>

    <div class="col-md-9">
      <div class="row align-items-center">
       <div class="col-md-10">
          <h1 class="fs-2 fw-bold mb-4">商品一覧<span class="fs-4"> (全<%= @items.total_count %>件) </span></h1>
            <div class="row">
              <% @items.each do |item| %>
                <div class="col-6 col-md-3 mt-4">
                  <div>
                    <%= link_to item_path(item) do %>
                      <%= image_tag item.get_item_image(240,160), class: "border img-fluid" %>
                    <% end %>
                  </div>
                  <p class="mt-2 mb-0 "><%= link_to item.name, item_path(item) %></p>
                  <p>¥<%= number_with_delimiter(item.with_tax_price) %></p>
                </div>
              <% end %>
            </div>
            <div class="fs-6 mt-5 mb-4"><%= paginate @items %></div>
        </div>
      </div>
    </div>

  </div>
</div>
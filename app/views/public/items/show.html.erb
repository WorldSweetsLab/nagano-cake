<div class="container-fluid mt-5 mb-5 pb-5">
  <div class="row">

    <div class="col-md-3">
      <div class="mx-auto w-50 border border-dark border-2 pb-5">
        <h2 class="fs-6 fw-bold text-center py-1 border-bottom border-dark border-2">ジャンル検索</h2>
        <% @genres.each do |genre| %>
          <p class="ps-3"><%= genre.name%></p>
        <% end %>
      </div>
    </div>

    <div class="col-md-9">
      <div class="row align-items-start mb-5 pb-5">
        <div class="col-md-5">
          <div><%= image_tag @item.get_item_image(400,400), class: "rounded-circle img-fluid " %></div>
        </div>
        <div class="col-md-5">
          <span class="d-inline-block fs-6 px-3 py-1 mb-4 badge bg-dark">
            <%= @item.genre.name %>
          </span>
          <h1 class="fs-2 fw-bold mb-4"><%= @item.name %></h1>
          <p class="fs-6 pb-5 border-bottom"><%= @item.description %></p>
          <p class="fs-3 my-4">¥<%= number_with_delimiter(@item.with_tax_price) %><span class="fs-6 ms-2">(税込)</span></p>
          <% if authenticated_customer? %>
            <%= form_with scope: :cart_item, url: cart_items_path, method: :post do |f| %>
              <div class="d-flex gap-5">
                <%= f.hidden_field :item_id, value: @item.id %>
                <%= f.select :amount, (1..10).to_a, {prompt: "個数選択"}, class: "form-select w-auto", required: true %>
                <%= f.submit "カートに入れる", class: "btn btn-success w-auto" %>
              </div>
            <% end %>
          <% else %>
            <p>カートへの追加にはログインが必要です</p>
            <%= link_to "ログインする", new_session_path, class: "btn btn-success w-auto" %>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</duv>
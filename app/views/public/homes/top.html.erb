<div class="container-fluid pt-5 pb-5 item-index home-top">
  <div class="row">
    <div class="col-md-3">
      <div class="mx-auto w-50 top-genre">
        <h2 class="fs-6 fw-bold mb-4 pb-3 border-bottom top-genre-title">ジャンル検索</h2>
        <% @genres.each do |genre| %>
          <p class="ps-3"><%= link_to genre.name, items_path(genre_id: genre.id)%></p>
        <% end %>
      </div>
    </div>

    <div class="col-md-9 pe-md-4 pe-lg-5">
      <div class="row">
        <div class="col-md-11">
          <div class="row align-items-center mb-3 py-5 px-4 top-hero">
            <div class="col-md-5 p-3">
              <%= image_tag "main_cake.png", class: "img-fluid top-hero-cake ms-4" %>
            </div>
            <div class="col-md-7">
              <div class="w-75 border-bottom border-white mb-4 pb-3">
                <h1 class="fs-3 fw-normal mb-2">ようこそ、ながのCAKEへ !</h1>
              </div>
              <p class="lh-lg">このサイトは、ケーキ販売のECサイトになります。<br>
                会員でない方も商品の閲覧はできますが、<br>
                購入には会員登録が必要になります。</p>
            </div>
          </div>
        </div>

      <div class="row mt-4 mb-2 gx-4">
        <h2 class="fs-4 fw-normal mb-4 d-flex align-items-center gap-3 top-section-title">
          新着商品
          <span class="top-section-line"></span>
        </h2>
          <% @items.each do |item| %>
            <div class="col-6 col-md-3 mb-4">
              <div>
                <%= link_to item_path(item) do %>
                  <%= image_tag item.get_item_image(270,180), class: "img-fluid w-100" %>
                <% end %>
              </div>
              <p class="mt-2 mb-2">
                <%= link_to item.name, item_path(item) %>
              </p>
              <div class="top-item-line mb-2"></div>
              <p class="text-dark">¥<%= number_with_delimiter(item.with_tax_price) %></p>
            </div>
          <% end %>
      </div>

      <div class="text-end pe-3">
        <%= link_to "全ての商品を見る > ", items_path %>
      </div>

    </div>
  </div>
</div>
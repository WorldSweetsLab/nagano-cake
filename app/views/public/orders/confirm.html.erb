
<div class="container-fluid pt-4">
  <h3 class="bg-light mb-3 px-4 fw-bold d-inline-block offset-1">注文情報確認</h3>

  <%= form_with model: @order, url: orders_path do |f| %>
    <div class="row">
      <div class="col-lg-8">
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>商品名</th>
              <th>単価（税込）</th>
              <th>数量</th>
              <th>小計</th>
            </tr>
          </thead>

          <tbody>
            <% @cart_items.each do |cart_item| %>
              <tr>
                <td><%= cart_item.item.name %></td>
                <td><%= cart_item.item.with_tax_price.to_s(:delimited) %>円</td>
                <td><%= cart_item.amount %></td>
                <td><%= cart_item.subtotal.to_s(:delimited) %>円</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="col-lg-4">
        <table class="table table-bordered">
          <tbody>
            <tr>
              <th>送料</th>
              <td><%= @order.shipping_cost %>円</td>
            </tr>
            <tr>
              <th>商品合計</th>
              <td><%= number_with_delimiter(@cart_items.sum(&:subtotal)) %>円</td>
            </tr>
            <tr>
              <th>請求金額</th>
              <td>
                <%= number_with_delimiter((@cart_items.sum(&:subtotal) + @order.shipping_cost)) %>円
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-4 col-md-2 fw-bold">支払方法</div>
      <div class="col-8">
        <%= @order.payment_method_i18n %>
      </div>
    </div>

    <div class="row mt-3">
      <div class="col-4 col-md-2 fw-bold">お届け先</div>
      <div class="col-8">
        〒<%= @order.postal_code %><%= @order.address %><br>
        <%= @order.name %>
      </div>
    </div>

    <%= f.hidden_field :payment_method %>
    <%= f.hidden_field :postal_code %>
    <%= f.hidden_field :address %>
    <%= f.hidden_field :name %>
    <%= f.hidden_field :shipping_cost %>

    <div class="row my-4">
      <div class="col-4 offset-4 text-center">
        <%= f.submit "注文を確定する", class: "btn btn-success" %>
      </div>
    </div>
  <% end %>
</div>

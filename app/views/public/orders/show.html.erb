<% subtotal = @order.order_details.sum { |detail| detail.price * detail.amount } %>
<div class="container-fluid pt-4">
  <div class="row">
    <div class="col-10 ms-5">
      <h3 class="bg-light mb-3 px-4 fw-bold d-inline-block offset-1">注文履歴詳細</h3>
      <div class="row">
        <div class="col-6">
          <h5 class="mb-3">注文情報</h5>
          <table class="table table-bordered border-dark">
            <tbody>
              <tr>
                <th class="table-light border-dark">注文日</th>
                <td><%= @order.created_at.strftime('%Y/%m/%d') %></td>
              </tr>
              <tr>  
                <th class="table-light border-dark">配送先</th>
                <td>〒<%= @order.postal_code %><br>
                      <%= @order.address %><br>
                      <%= @order.name %>
                </td>
              </tr>
              <tr>    
                <th class="table-light border-dark">支払方法</th>
                <td><%= @order.payment_method_i18n %></td>
              </tr>
              <tr>  
                <th class="table-light border-dark">ステータス</th>
                <td><%= @order.status_i18n %></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-4 ms-3">
          <h5 class="mb-3">請求情報</h5>
          <table class="table table-bordered border-dark">
            <tbody>
              <tr>
                <th class="table-light border-dark">商品合計</th>
                <td><%= number_with_delimiter(subtotal) %>円</td>
              </tr>
              <tr>  
                <th class="table-light border-dark">配送料</th>
                <td><%= @order.shipping_cost %></td>
              </tr>
              <tr>  
                <th class="table-light border-dark">ご請求額</th>
                <td><%= number_with_delimiter(@order.total_payment) %>円</td>
              </tr>
            </tbody>
          </table>
        </div>     
      </div>
      <div class="row mt-3">
        <div class="col-8">
          <h5 class="mb-3">注文内容</h5>
          <table class="table table-bordered border-dark">
            <thead class="table-light border-dark">
              <tr>
                <th>商品</th>
                <th>単価（税込）</th>
                <th>個数</th>
                <th>小計</th>
              <tr>
            </thead>
            <tbody>
              <% @order.order_details.each do |order_detail| %>
               <tr>
                  <td><%= order_detail.item.name %></td>  
                  <td><%= number_with_delimiter(order_detail.price) %></td>
                  <td><%= order_detail.amount %></td>
                  <td><%= number_with_delimiter(order_detail.price * order_detail.amount) %></td>
                </tr>  
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>  
  </div>
</div>          

<main>
  <div class="container">
    <div class="row mt-5">
      <div class="col-10">
        <h3 class="bg-light my-5 offset-1 px-4"style="display: inline-block;">新規会員登録</h3>
        <form>
          <%= form_with model: @customer, url: signup_path do |f| %>
            #下のエラー共通プレートにできないか要確認
            <% if @customer.errors.any? %>
              <div style="color:red">
              <ui>
                <% @customer.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ui>  
              </div>
            <% end %>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">名前</label>
              <div class="col-sm-4">
                <div class="input-group">
                  <div class="input-group-text">(姓)</div>
                   <%= f.text_field :last_name, class: "form-control",style: "border-color: black;", required: true %>
                </div>
              </div>
              <div class="col-sm-4 ms-5">
                <div class="input-group">
                  <div class="input-group-text">(名)</div>
                   <%= f.text_field :first_name, class: "form-control",style: "border-color: black;", required: true %>
                </div>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">フリガナ</label>
              <div class="col-sm-4">
                <div class="input-group">
                  <div class="input-group-text">(セイ)</div>
                   <%= f.text_field :last_name_kana, class: "form-control",style: "border-color: black;", required: true %>
                </div>
              </div>
              <div class="col-sm-4 ms-5">
                <div class="input-group">
                  <div class="input-group-text">(メイ)</div>
                   <%= f.text_field :first_name_kana, class: "form-control",style: "border-color: black;", required: true %>
                </div>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">メールアドレス</label>
              <div class="col-sm-4">
                <%= f.email_field :email_address, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">郵便番号（ハイフンなし）</label>
              <div class="col-sm-4">
                <%= f.text_field :postal_code, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">住所</label>
              <div class="col-sm-9">
                <%= f.text_field :address, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">電話番号（ハイフンなし）</label>
              <div class="col-sm-4">
                <%= f.text_field :phone_number, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">パスワード（６文字以上）</label>
              <div class="col-sm-4">
                <%= f.password_field :password, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-4">
              <label class="col-sm-3 col-form-label">パスワード（確認用）</label>
              <div class="col-sm-4">
                <%= f.password_field :password_confirmation, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-sm-3 offset-sm-3">
              <%= f.submit "新規登録", class: "btn btn-success w-100" %>
              </div>
            </div>
          <% end %>
        </form>
        <h3 class="bg-light mt-5 offset-1 px-4"style="display: inline-block;">既に登録済みの方</h3>
        <h5 class="mt-2 offset-2"><%= link_to "こちら", new_session_path %> からログインしてください。</h5>
      </div>
    </div>
  </div>
</main>  
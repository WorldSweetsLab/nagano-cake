<div class="container" style="padding-bottom: 50px;">
  <div class="row mt-5">
    <div class="col-9">
      <h3 class="bg-light mb-5 offset-2 px-4"style="display: inline-block;">マイページ</h3>
      <div class="row align-items-center mb-3">
        <div class="col-auto">
          <h3 class="mb-o">登録情報</h3>
        </div>  
        <div class="col-auto">
          <%= link_to "編集する", edit_customer_information_path, class: "btn btn-success" %>
        </div>
      </div>  
      <table class="table table-bordered mt-3 border-dark">
        <tbody>
          <tr>
            <th class="table-light border-dark">氏名</th>
            <td><%= @customer.last_name %> <%= @customer.first_name %></td>
          </tr>
          <tr>
            <th class="table-light border-dark">カナ</th>
            <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
          </tr>
          <tr>
            <th class="table-light border-dark">郵便番号</th>
            <td><%= @customer.postal_code %></td>
          </tr>
          <tr>
            <th class="table-light border-dark">住所</th>
            <td><%= @customer.address %></td>
          </tr>
          <tr>
            <th class="table-light border-dark">電話番号</th>
            <td><%= @customer.phone_number %></td>
          </tr>
          <tr>
            <th class="table-light border-dark">メールアドレス</th>
            <td><%= @customer.email_address %></td>
          </tr>
        </tbody>
      </table>
      <div class="row align-items-center">
        <div class="col-2">
          <h4 class="mb-0">配送先</h4>
        </div>
        <div class="col-auto">  
          <%= link_to "一覧を見る", addresses_path, class: "btn btn-primary" %>
      </div>
      <div class="row align-items-center mt-3 mb-5">
        <div class="col-2">
          <h4 class="mb-0">注文履歴</h4>
        </div>
        <div class="col-auto">  
          <%= link_to "一覧を見る", orders_path, class: "btn btn-primary" %>
        </div>
      </div>  
    </div>
  </div>
</div>

       
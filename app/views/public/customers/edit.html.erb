<main>
  <div class="container">
    <div class="row mt-5">
      <div class="col-10">
        <h3 class="bg-light my-5 offset-1 px-4"style="display: inline-block;">会員情報編集</h3>
        <%= form_with model: @customer, url: edit_customer_path do |f| %>
          <% if @customer.errors.any? %>
            <div style="color:red">
            <ui>
              <% @customer.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ui>  
            </div>
          <% end %>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">氏名</label>
            <div class="col-sm-4">
              <%= f.text_field :last_name, class: "form-control",style: "border-color: black;", required: true %>
            </div>
            <div class="col-sm-4 ms-3">
              <%= f.text_field :first_name, class: "form-control",style: "border-color: black;", required: true %>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">フリガナ</label>
            <div class="col-sm-4">
              <%= f.text_field :last_name_kana, class: "form-control",style: "border-color: black;", required: true %>
            </div>
            <div class="col-sm-4 ms-3">
              <%= f.text_field :first_name_kana, class: "form-control",style: "border-color: black;", required: true %>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">郵便番号</label>
            <div class="col-sm-4">
              <%= f.text_field :postal_code, class: "form-control",style: "border-color: black;", required: true %>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">住所</label>
            <div class="col-sm-9">
              <%= f.text_field :address, class: "form-control",style: "border-color: black;", required: true %>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">電話番号</label>
            <div class="col-sm-4">
              <%= f.text_field :phone_number, class: "form-control",style: "border-color: black;", required: true %>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">メールアドレス</label>
            <div class="col-sm-4">
              <%= f.email_field :email_address, class: "form-control",style: "border-color: black;", required: true %>
            </div>
          </div>

          <div class="row">
            <div class="col-sm-4 offset-3">
            <%= f.submit "編集内容を保存", class: "btn btn-success w-100" %>
            <%= link_to "退会する", withdraw_customer_path, data: { turbo_method: :patch, turbo_confirm: "本当に退会しますか？退会すると再ログインできなくなります。" }, class: "btn btn-danger" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>  
<div class="container-fluid pt-4">
  <div class="row">
    <div class="col-8 mx-auto">

<h4 class="mb-3">ショッピングカート</h4>
<%= button_to "カートを空にする", destroy_all_cart_items_path, method: :delete, class: "btn btn-danger " %>

  <table class="table">
    <thead>
      <tr class="table-secondary">
        <th>商品名</th>
        <th>単価(税込)</th>
        <th>数量</th>
        <th>小計</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    <% @cart_items.each do |cart_item| %>
        <tr>
            <td>
              <%= image_tag cart_item.item.get_item_image(75,50), class: "border" %>
              <%= cart_item.item.name %>
            </td>
            <td><%= number_with_delimiter(cart_item.item.with_tax_price) %></td>
            <td>
              <%= form_with scope: :cart_item, url: cart_item_path(cart_item), method: :patch do |f| %>
                <%= f.select :amount, (1..10).to_a, selected: cart_item.amount %>
                <%= f.submit "変更", class: "btn btn-success" %>
              <% end %>
            </td>
            <td><%= number_with_delimiter(cart_item.subtotal) %></td>
            <td>
              <%= button_to "削除する", cart_item_path(cart_item), method: :delete, class: "btn btn-danger" %>
            </td>
        </tr>
        <% @total_price +=  cart_item.subtotal %>
    <% end %>
    </tbody>
  </table>

  <table class="table w-25 ms-auto">
    <tbody>
      <tr>
        <th scope="row" class="table-secondary">合計金額</th>
        <th><%= number_with_delimiter(@total_price) %></th>
      </tr>
    </tbody>
  </table>

  <%= link_to "買い物を続ける", items_path, class: "btn btn-primary" %>
  <button type="button" class="btn btn btn-success">情報入力に進む</button>



<div class="container-fluid pt-4">
  <div class="row">
    <div class="col-8 mx-auto">

<h4 class="mb-3">ショッピングカート</h4>
  <table class="table">
    <thead>
      <tr class="table-secondary">
        <th>商品名</th>
        <th>単価(税込)</th>
        <th>数量</th>
        <th>小計</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    <% @cart_items.each do |cart_item| %>
        <tr>
            <td>
              <%= image_tag cart_item.item.get_item_image(75,50), class: "border" %>
              <%= cart_item.item.name %>
            </td>
            <td><%= cart_item.item.with_tax_price %></td>
            <td><%= cart_item.amount %></td>
            <td><%= cart_item.subtotal %></td>
            <td>削除する</td>
        </tr>
        <% @total_price +=  cart_item.subtotal %>
    <% end %>
    </tbody>
  </table>

  <table class="table w-25 ms-auto">
    <tbody>
      <tr>
        <th scope="row" class="table-secondary">合計金額</th>
        <th><%= @total_price %></th>
      </tr>
    </tbody>
  </table>

  <%= form_with url: cart_items_path, method: :post do |f| %>
<% end %>

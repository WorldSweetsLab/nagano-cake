<div class="container-fluid pt-4 ">
  <div class="row">
    <div class="col-8 mx-auto">

      <div class=" d-flex justify-content-between align-items-center py-4">
        <h1 class="mb-0 fs-4 fw-bold">ショッピングカート</h1>
        <%= button_to "カートを空にする", destroy_all_cart_items_path, 
            method: :delete, class: "btn btn-danger me-2" %>
      </div>

  <table class="table align-middle">
    <thead>
      <tr class="table-secondary">
        <th class="py-3">商品名</th>
        <th class="py-3">単価(税込)</th>
        <th class="py-3 w-25">数量</th>
        <th class="py-3">小計</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    <% @cart_items.each do |cart_item| %>
        <tr>
            <td class="py-4 fw-normal">
              <%= image_tag cart_item.item.get_item_image(75,50), class: "border me-2" %>
              <%= cart_item.item.name %>
            </td>
            <td class="py-4 fw-normal"><%= number_with_delimiter(cart_item.item.with_tax_price) %></td>
            <td class="py-4 fw-normal">
              <%= form_with scope: :cart_item, url: cart_item_path(cart_item), method: :patch do |f| %>
                <div class="d-flex align-items-center gap-3">
                  <%= f.number_field :amount, value: cart_item.amount, min: 1, step: 1, class: "form-control w-25" %>
                  <%= f.submit "変更", class: "btn btn-success" %>
                </div>
              <% end %>
            </td>
            <td class="py-4 fw-normal"><%= number_with_delimiter(cart_item.subtotal) %></td>
            <td class="py-4 fw-normal">
              <%= button_to "削除する", cart_item_path(cart_item), method: :delete, class: "btn btn-danger" %>
            </td>
        </tr>
        <% @total_price +=  cart_item.subtotal %>
    <% end %>
    </tbody>
  </table>


<div class=" d-flex justify-content-between align-items-center py-4">
  <%= link_to "買い物を続ける", items_path, class: "btn btn-primary ms-5" %>
    <table class="table w-25 mb-0 table-bordered">
    <tbody>
      <tr>
        <th scope="row" class="table-secondary py-3">合計金額</th>
        <th class="py-3"><%= number_with_delimiter(@total_price) %></th>
      </tr>
    </tbody>
  </table>
  </div>

  <div class="d-flex justify-content-center mt-3 mb-5 pb-5">
    <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success" %>
  </div>

  



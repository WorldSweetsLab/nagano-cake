<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">

      <%# 見出しと新規登録ボタンを左右に配置する %>
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-4 bg-light px-4 py-1 mb-0">商品一覧</h1>

        <%= link_to "＋", new_admin_item_path,
            class: "btn btn-outline-secondary rounded-circle fs-4",
            style: "width: 48px; height: 48px;",
            aria: { label: "商品を新規登録" } %>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col">商品ID</th>
              <th scope="col">商品名</th>
              <th scope="col">税抜価格</th>
              <th scope="col">ジャンル</th>
              <th scope="col">販売状態</th>
            </tr>
          </thead>

          <tbody>
            <% @items.each do |item| %>
              <tr>
                <td class="py-3"><%= item.id %></td>
                <td class="py-3">
                  <%= link_to item.name, admin_item_path(item),
                      class: "text-dark" %>
                </td>
                <td class="py-3">
                  <%= number_with_delimiter(item.price) %>円
                </td>
                <td class="py-3"><%= item.genre.name %></td>
                <td class="py-3">
                  <% if item.is_active? %>
                    <span class="text-success fw-bold">販売中</span>
                  <% else %>
                    <span class="text-secondary fw-bold">販売停止中</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# ページ切り替えのリンクを表示する %>
      <div class="d-flex justify-content-center mt-4">
        <%= paginate @items %>
      </div>

    </div>
  </div>
</div>
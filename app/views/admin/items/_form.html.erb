<% if @item.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @item], class: "admin-item-form" do |f| %>
  <div class="row mb-4">
    <%= f.label :image, "商品画像", class: "col-sm-3 col-form-label" %>
    <div class="col-sm-9">
      <% if @item.persisted? && @item.image.attached? %>
        <div class="mb-3">
          <%= image_tag @item.image, width: 150,
              class: "img-fluid border", alt: @item.name %>
        </div>
      <% end %>
      <%= f.file_field :image, accept: "image/*", class: "form-control" %>
    </div>
  </div>

  <div class="row mb-4">
    <%= f.label :name, "商品名", class: "col-sm-3 col-form-label" %>
    <div class="col-sm-9">
      <%= f.text_field :name, class: "form-control" %>
    </div>
  </div>

  <div class="row mb-4">
    <%= f.label :description, "商品説明", class: "col-sm-3 col-form-label" %>
    <div class="col-sm-9">
      <%= f.text_area :description, rows: 5, class: "form-control" %>
    </div>
  </div>

  <div class="row mb-4">
    <%= f.label :genre_id, "ジャンル", class: "col-sm-3 col-form-label" %>
    <div class="col-sm-9">
      <%= f.collection_select :genre_id, @genres, :id, :name,
          { prompt: "選択してください" }, { class: "form-select" } %>
    </div>
  </div>

  <div class="row mb-4">
    <%= f.label :price, "税抜価格", class: "col-sm-3 col-form-label" %>
    <div class="col-sm-9">
     <div class="d-flex align-items-center gap-2">
  <%= f.number_field :price, min: 1, step: 1, class: "form-control" %>
  <span class="text-nowrap">円</span>
     </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-sm-3 col-form-label">販売状態</div>
    <div class="col-sm-9 d-flex flex-wrap align-items-center gap-4">
      <div class="form-check">
        <%= f.radio_button :is_active, true, class: "form-check-input" %>
        <%= f.label :is_active_true, "販売中", class: "form-check-label" %>
      </div>
      <div class="form-check">
        <%= f.radio_button :is_active, false, class: "form-check-input" %>
        <%= f.label :is_active_false, "販売停止中", class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="text-center mt-5">
    <%= f.submit @item.persisted? ? "変更を保存" : "新規登録",
        class: "btn btn-success px-5" %>
  </div>
<% end %>
<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-4">
        注文履歴一覧
      </h1>

      <% if @orders.empty? %>
        <p>注文はまだありません。</p>
      <% else %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>注文ID</th>
                <th>購入日時</th>
                <th>購入者名</th>
                <th class="text-end">注文個数</th>
                <th class="text-end">請求額</th>
                <th>注文ステータス</th>
              </tr>
            </thead>

            <tbody>
              <% @orders.each do |order| %>
                <tr>
                  <td class="py-3">
                    <%= link_to order.id, admin_order_path(order),
                        class: "text-dark" %>
                  </td>
                  <td class="py-3 text-nowrap">
                    <%= order.created_at.strftime("%Y/%m/%d %H:%M") %>
                  </td>
                  <td class="py-3">
                    <%= order.customer.last_name %>
                    <%= order.customer.first_name %>
                  </td>
                  <td class="py-3 text-end text-nowrap">
                    <%= order.order_details.sum(&:amount) %>個
                  </td>
                  <td class="py-3 text-end text-nowrap">
                    <%= number_with_delimiter(order.total_payment) %>円
                  </td>
                  <td class="py-3 text-nowrap">
                    <%= order.status_i18n %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-center mt-4">
          <%= paginate @orders %>
        </div>
      <% end %>

      <div class="mt-4">
        <%= link_to "管理者トップへ戻る", admin_top_path,
            class: "text-secondary" %>
      </div>
    </div>
  </div>
</div>
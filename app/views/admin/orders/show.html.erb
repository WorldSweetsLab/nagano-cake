<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-5">
        注文履歴詳細
      </h1>

          <%# 注文情報 %>
      <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle mb-0">
          <tbody>
            <tr>
              <th scope="row" class="table-light w-25 text-nowrap">
                注文ID
              </th>
              <td><%= @order.id %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">購入者</th>
              <td>
                <%= link_to "#{@order.customer.last_name} #{@order.customer.first_name}",
                    admin_customer_path(@order.customer), class: "text-dark" %>
              </td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">購入日時</th>
              <td>
                <%= @order.created_at.strftime("%Y/%m/%d %H:%M") %>
              </td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">配送先</th>
              <td class="text-break">
                〒<%= @order.postal_code %><br>
                <%= @order.address %><br>
                <%= @order.name %>
              </td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">支払方法</th>
              <td><%= @order.payment_method_i18n %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">
                注文ステータス
              </th>
              <td>
                <%= form_with model: [:admin, @order],
                    class: "d-flex flex-wrap align-items-center gap-2" do |f| %>
                  <%= f.label :status, "注文ステータス",
                      class: "visually-hidden" %>
                  <%= f.select :status, Order.statuses_i18n.invert,
                      {}, { class: "form-select w-auto" } %>
                  <%= f.submit "更新", class: "btn btn-success" %>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

       <div class="row g-4 align-items-start">
        <%# 左側：注文商品と製作ステータス %>
        <div class="col-lg-8">
          <h2 class="fs-5 mb-3">注文商品</h2>

          <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>商品名</th>
                  <th class="text-end">単価（税込）</th>
                  <th class="text-end">数量</th>
                  <th class="text-end">小計</th>
                  <th>製作ステータス</th>
                </tr>
              </thead>

              <tbody>
                <% @order_details.each do |detail| %>
                  <tr>
                    <td class="py-3"><%= detail.item.name %></td>
                    <td class="py-3 text-end text-nowrap">
                      <%= number_with_delimiter(detail.price) %>円
                    </td>
                    <td class="py-3 text-end"><%= detail.amount %></td>
                    <td class="py-3 text-end text-nowrap">
                      <%= number_with_delimiter(detail.price * detail.amount) %>円
                    </td>
                    <td class="py-3">
                      <%= form_with model: [:admin, detail],
                          class: "d-flex flex-wrap gap-2" do |f| %>
                        <%= f.select :making_status,
                            OrderDetail.making_statuses_i18n.invert,
                            {},
                            {
                              class: "form-select w-auto",
                              id: "making_status_#{detail.id}",
                              "aria-label": "#{detail.item.name}の製作ステータス"
                            } %>
                        <%= f.submit "更新", class: "btn btn-success" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# 右側：請求情報 %>
        <div class="col-lg-4">
          <h2 class="fs-5 mb-3">請求情報</h2>

          <table class="table table-bordered align-middle mb-0">
            <tbody>
              <tr>
               <th class="table-light fw-normal">商品合計</th>
                <td class="text-end text-nowrap">
                  <%= number_with_delimiter(@items_total) %>円
                </td>
              </tr>
              <tr>
                <th class="table-light fw-normal">送料</th>
                <td class="text-end text-nowrap">
                  <%= number_with_delimiter(@order.shipping_cost) %>円
                </td>
              </tr>
              <tr>
                <th class="table-light">請求額合計</th>
                <td class="text-end text-nowrap fw-bold">
                  <%= number_with_delimiter(@order.total_payment) %>円
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-4">
        <%= link_to "注文一覧へ戻る", admin_orders_path,
            class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
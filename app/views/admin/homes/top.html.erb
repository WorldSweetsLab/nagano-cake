<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-4">
        管理者トップ
      </h1>

      <p class="text-break mb-5">
        ログイン中：<%= current_admin.email_address %>
      </p>

      <%# 各管理画面へのメニュー %>
      <div class="row g-4">
        <div class="col-12 col-sm-6">
          <%= link_to "商品一覧", admin_items_path,
              class: "btn btn-outline-dark d-block py-4" %>
        </div>

        <div class="col-12 col-sm-6">
          <%= link_to "会員一覧", admin_customers_path,
              class: "btn btn-outline-dark d-block py-4" %>
        </div>

        <div class="col-12 col-sm-6">
          <%= link_to "注文履歴一覧", admin_orders_path,
              class: "btn btn-outline-dark d-block py-4" %>
        </div>

        <div class="col-12 col-sm-6">
          <%= link_to "ジャンル一覧", admin_genres_path,
              class: "btn btn-outline-dark d-block py-4" %>
        </div>
      </div>
    </div>
  </div>
</div>
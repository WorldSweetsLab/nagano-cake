<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-5">
        会員情報編集
      </h1>

      <% if @customer.errors.any? %>
        <div class="alert alert-danger">
          <p>入力内容を確認してください。</p>
          <ul class="mb-0">
            <% @customer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row mb-4">
        <div class="col-sm-3">会員ID</div>
        <div class="col-sm-9"><%= @customer.id %></div>
      </div>

      <%= form_with model: [:admin, @customer], class: "admin-customer-form" do |f| %>
        <div class="row mb-4">
          <div class="col-sm-3 col-form-label">氏名</div>
          <div class="col-sm-9">
            <div class="row g-2">
              <div class="col-6">
                <%= f.label :last_name, "姓", class: "visually-hidden" %>
                <%= f.text_field :last_name, class: "form-control", placeholder: "姓" %>
              </div>
              <div class="col-6">
                <%= f.label :first_name, "名", class: "visually-hidden" %>
                <%= f.text_field :first_name, class: "form-control", placeholder: "名" %>
              </div>
            </div>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-sm-3 col-form-label">フリガナ</div>
          <div class="col-sm-9">
            <div class="row g-2">
              <div class="col-6">
                <%= f.label :last_name_kana, "セイ", class: "visually-hidden" %>
                <%= f.text_field :last_name_kana, class: "form-control", placeholder: "セイ" %>
              </div>
              <div class="col-6">
                <%= f.label :first_name_kana, "メイ", class: "visually-hidden" %>
                <%= f.text_field :first_name_kana, class: "form-control", placeholder: "メイ" %>
              </div>
            </div>
          </div>
        </div>

        <div class="row mb-4">
          <%= f.label :postal_code, "郵便番号", class: "col-sm-3 col-form-label" %>
          <div class="col-sm-9">
            <%= f.text_field :postal_code, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4">
          <%= f.label :address, "住所", class: "col-sm-3 col-form-label" %>
          <div class="col-sm-9">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4">
          <%= f.label :phone_number, "電話番号", class: "col-sm-3 col-form-label" %>
          <div class="col-sm-9">
            <%= f.telephone_field :phone_number, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4">
          <%= f.label :email_address, "メールアドレス", class: "col-sm-3 col-form-label" %>
          <div class="col-sm-9">
            <%= f.email_field :email_address, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-sm-3 col-form-label">会員ステータス</div>
          <div class="col-sm-9 d-flex flex-wrap align-items-center gap-4">
            <div class="form-check">
              <%= f.radio_button :is_active, true, class: "form-check-input" %>
              <%= f.label :is_active_true, "有効", class: "form-check-label" %>
            </div>
            <div class="form-check">
              <%= f.radio_button :is_active, false, class: "form-check-input" %>
              <%= f.label :is_active_false, "退会", class: "form-check-label" %>
            </div>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-3 mt-5">
          <%= f.submit "変更を保存", class: "btn btn-success px-5" %>
          <%= link_to "会員詳細へ戻る", admin_customer_path(@customer),
              class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
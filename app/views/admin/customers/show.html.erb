<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-5">
        <%= @customer.last_name %> <%= @customer.first_name %>さんの会員詳細
      </h1>

      <dl class="row gy-3 mb-4">
        <dt class="col-sm-3 fw-normal">会員ID</dt>
        <dd class="col-sm-9 mb-0"><%= @customer.id %></dd>

        <dt class="col-sm-3 fw-normal">氏名</dt>
        <dd class="col-sm-9 mb-0">
          <%= @customer.last_name %> <%= @customer.first_name %>
        </dd>

        <dt class="col-sm-3 fw-normal">フリガナ</dt>
        <dd class="col-sm-9 mb-0">
          <%= @customer.last_name_kana %> <%= @customer.first_name_kana %>
        </dd>

        <dt class="col-sm-3 fw-normal">郵便番号</dt>
        <dd class="col-sm-9 mb-0"><%= @customer.postal_code %></dd>

        <dt class="col-sm-3 fw-normal">住所</dt>
        <dd class="col-sm-9 mb-0 text-break"><%= @customer.address %></dd>

        <dt class="col-sm-3 fw-normal">電話番号</dt>
        <dd class="col-sm-9 mb-0"><%= @customer.phone_number %></dd>

        <dt class="col-sm-3 fw-normal">メールアドレス</dt>
        <dd class="col-sm-9 mb-0 text-break">
          <%= @customer.email_address %>
        </dd>

        <dt class="col-sm-3 fw-normal">会員ステータス</dt>
        <dd class="col-sm-9 mb-0">
          <% if @customer.is_active %>
            <span class="text-success fw-bold">有効</span>
          <% else %>
            <span class="text-secondary fw-bold">退会</span>
          <% end %>
        </dd>
      </dl>

      <div class="d-flex flex-wrap gap-3 mt-5">
        <%= link_to "編集する", edit_admin_customer_path(@customer),
            class: "btn btn-success px-5" %>
        <%= link_to "会員一覧へ戻る", admin_customers_path,
            class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
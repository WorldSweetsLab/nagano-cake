<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-4">
        <%= @customer.last_name %> <%= @customer.first_name %>さんの会員詳細
      </h1>

      <%# 項目名と登録内容を、枠線付きの表で表示する %>
      <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0">
          <tbody>
            <tr>
              <th scope="row" class="table-light w-25 text-nowrap">
                会員ID
              </th>
              <td><%= @customer.id %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">氏名</th>
              <td>
                <%= @customer.last_name %> <%= @customer.first_name %>
              </td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">フリガナ</th>
              <td>
                <%= @customer.last_name_kana %> <%= @customer.first_name_kana %>
              </td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">郵便番号</th>
              <td><%= @customer.postal_code %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">住所</th>
              <td class="text-break"><%= @customer.address %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">電話番号</th>
              <td><%= @customer.phone_number %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">
                メールアドレス
              </th>
              <td class="text-break"><%= @customer.email_address %></td>
            </tr>
            <tr>
              <th scope="row" class="table-light text-nowrap">
                会員ステータス
              </th>
              <td>
                <% if @customer.is_active %>
                  <span class="text-success fw-bold">有効</span>
                <% else %>
                  <span class="text-secondary fw-bold">退会</span>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex flex-wrap gap-3 mt-4">
        <%= link_to "編集する", edit_admin_customer_path(@customer),
            class: "btn btn-success px-5" %>
        <%= link_to "会員一覧へ戻る", admin_customers_path,
            class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
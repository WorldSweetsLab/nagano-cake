<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-10 mx-auto">
      <h1 class="fs-4 bg-light d-inline-block px-4 py-1 mb-5">
        ジャンル編集
      </h1>

      <% if @genre.errors.any? %>
        <div class="alert alert-danger">
          <p class="mb-0">
            ジャンルを更新できませんでした。ジャンル名を入力してください。
          </p>
        </div>
      <% end %>

      <%= form_with model: [:admin, @genre],
          class: "row g-3 align-items-center mb-5" do |f| %>
        <div class="col-12 col-sm-auto">
          <%= f.label :name, "ジャンル名", class: "col-form-label" %>
        </div>
        <div class="col-12 col-sm-6">
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="col-12 col-sm-auto">
          <%= f.submit "変更を保存", class: "btn btn-success px-4" %>
        </div>
      <% end %>

        <div class="d-flex flex-wrap gap-3">
      <%= button_to "削除する", admin_genre_path(@genre),
        method: :delete,
         class: "btn btn-danger",
           form: {
      data: { turbo_confirm: "このジャンルを削除しますか？" }
                } %>

  <%= link_to "ジャンル一覧へ戻る", admin_genres_path,
      class: "btn btn-outline-secondary" %>
</div>
    </div>
  </div>
</div>
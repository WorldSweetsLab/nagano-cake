<h1>ジャンル一覧・追加</h1>
<tr>
  <th>ID</th>
  <th>ジャンル名</th>
  <th>操作</th>
</tr>

<% if @genre.errors.any? %>
  <p>ジャンルを登録できませんでした。ジャンル名を入力してください。</p>
<% end %>

<%= form_with model: [:admin, @genre] do |f| %>
  <%= f.label :name, "ジャンル名" %>
  <%= f.text_field :name %>
  <%= f.submit "新規登録" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>ジャンル名</th>
    </tr>
  </thead>
  
  <tbody>
    <% @genres.each do |genre| %>
<tr>
  <td><%= genre.id %></td>
  <td><%= genre.name %></td>
  <td><%= link_to "編集する", edit_admin_genre_path(genre) %></td>
</tr>
    <% end %>
  </tbody>
</table>

<%= link_to "管理者トップへ戻る", admin_top_path %>